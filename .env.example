# ==============================================================================
# OmniWA-Agent Environment Configuration Template
# Copy this file to .env: cp .env.example .env
# ==============================================================================

# --- Bot & Identity Settings ---
BOT_NAME=Aura
ORGANIZATION_NAME=OmniTech Solutions
# Domain preset: saas | ecommerce | education | services | custom
DOMAIN_PRESET=saas
# Primary language ('auto' enables dynamic language mirroring)
PRIMARY_LANGUAGE=auto
# Official contact hotline for customer self-service handoff
HOTLINE_PHONE=+1-555-0199
# WhatsApp JID for Tier 4 Emergency Crisis Dispatch (e.g. 15550199@s.whatsapp.net)
HOTLINE_JID=15550199@s.whatsapp.net
WEBSITE_URL=https://example.com

# --- LLM API & Provider Presets (OpenAI Compatible) ---
# Choose ONE of the provider setups below:

# [Preset 1: Local Ollama]
# AI_ENDPOINT=http://127.0.0.1:11434/v1
# AI_MODEL=llama3.2:latest
# AI_API_KEY=ollama

# [Preset 2: Groq Cloud (Ultra-Fast ~300ms)]
# AI_ENDPOINT=https://api.groq.com/openai/v1
# AI_MODEL=llama-3.3-70b-versatile
# AI_API_KEY=gsk_your_groq_api_key

# [Preset 3: DeepSeek API]
# AI_ENDPOINT=https://api.deepseek.com/v1
# AI_MODEL=deepseek-chat
# AI_API_KEY=sk_your_deepseek_key

# [Preset 4: OpenRouter Universal Gateway]
# AI_ENDPOINT=https://openrouter.ai/api/v1
# AI_MODEL=google/gemini-2.5-flash
# AI_API_KEY=sk-or-v1-your_openrouter_key

# [Preset 5: Official OpenAI]
AI_ENDPOINT=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_API_KEY=sk-proj-your_openai_key
AI_TIMEOUT_MS=30000

# --- Vector Database & RAG Configuration ---
CHROMA_URL=http://127.0.0.1:8000
CHROMA_COLLECTION=omni_knowledge_base
KB_DIRECTORY=./knowledge_base

# --- Multi-Channel Escalation Alerts (Optional) ---
# Discord Webhook or generic HTTP POST endpoint (Slack / n8n / Zapier)
# ESCALATION_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_TOKEN
# Direct Telegram Bot alert notification
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRstuvWXyz
# TELEGRAM_CHAT_ID=-1001234567890

# --- Web Admin Ops Console & Security ---
PORT=3001
ADMIN_USER=admin
ADMIN_PASS=changeme-secure-password
# Enable Cloudflare Quick Tunnel for remote access without port forwarding
ENABLE_TUNNEL=false

# --- WhatsApp Anti-Ban & Pacing Controls ---
MIN_TYPING_DELAY_MS=1200
MAX_TYPING_DELAY_MS=4500
TYPING_MS_PER_CHAR=20
READ_RECEIPT_DELAY_MS=800
RATE_LIMIT_PER_MINUTE=12

# ==============================================================================
# OmniWA-Agent Environment Configuration Template
# Copy this file to .env: cp .env.example .env
# ==============================================================================

# --- Bot & Identity Settings ---
BOT_NAME=Aura
ORGANIZATION_NAME=OmniTech Solutions
# Domain preset: saas | ecommerce | education | services | custom
DOMAIN_PRESET=saas
# Primary language ('auto' enables dynamic language mirroring)
PRIMARY_LANGUAGE=auto
# Official contact hotline for customer self-service handoff
HOTLINE_PHONE=+1-555-0199
# WhatsApp JID for Tier 4 Emergency Crisis Dispatch (e.g. 15550199@s.whatsapp.net)
HOTLINE_JID=15550199@s.whatsapp.net
WEBSITE_URL=https://example.com

# --- LLM API & Provider Configuration (OpenAI Compatible) ---
# Compatible with OpenAI, Ollama, Groq, 9router, DeepSeek, vLLM, LocalAI
AI_ENDPOINT=http://127.0.0.1:20128/v1
AI_MODEL=ag/gemini-3.7-flash-low
AI_VISION_MODEL=ag/gemini-3.7-flash-low
AI_API_KEY=your-api-key-here
AI_TIMEOUT_MS=30000

# --- Vector Database & RAG Configuration ---
CHROMA_URL=http://127.0.0.1:8000
CHROMA_COLLECTION=omni_knowledge_base
KB_DIRECTORY=./knowledge_base

# --- Web Admin Ops Console & Security ---
PORT=3001
ADMIN_USER=admin
ADMIN_PASS=changeme-secure-password
# Enable Cloudflare Quick Tunnel for remote access without port forwarding
ENABLE_TUNNEL=false

# --- WhatsApp Anti-Ban & Pacing Controls ---
MIN_TYPING_DELAY_MS=1200
MAX_TYPING_DELAY_MS=4500
TYPING_MS_PER_CHAR=20
READ_RECEIPT_DELAY_MS=800
RATE_LIMIT_PER_MINUTE=12
